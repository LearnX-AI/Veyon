# Veyon Control Server - example environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file.

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Database ----
# SQLite stores everything in a single file - no DB server needed.
DATABASE_URL=sqlite:///./veyon_control.db

# ---- Security ----
# REQUIRED: a long random string used to authenticate API requests.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=replace_me_with_a_long_random_string

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_STRICT=10/minute

# ---- CORS ----
# JSON array of allowed origins. Use ["*"] for development only.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- File distribution ----
FILE_STORAGE_ROOT=/var/lib/veyon-server/uploads
FILE_RETENTION_DAYS=7
FILE_MAX_SIZE_BYTES=1073741824
FILE_CLEANUP_INTERVAL_SECONDS=3600
SUBMISSION_STORAGE_ROOT=/var/lib/veyon-server/submissions
